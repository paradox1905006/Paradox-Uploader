    <!-- Onboarding -->
    <string name="onboarding_1_title">Bring your own key</string>
    <string name="onboarding_1_body">Paradox Uploader sends files straight from your phone to the Internet Archive using your own S3 keys. There is no server in between.</string>
    <string name="onboarding_2_title">Upload now, link when ready</string>
    <string name="onboarding_2_body">Uploads keep running in the background. After archive.org has processed a file, you get a notification that the direct download link is ready.</string>
    <string name="onboarding_3_title">Get your keys</string>
    <string name="onboarding_3_body">Sign in at archive.org, open the S3 keys page and copy your Access Key and Secret Key into Settings.</string>
    <string name="open_keys_page">Open archive.org keys page</string>
    <string name="rationale_title">Stay up to date</string>
    <string name="rationale_body">Notifications show upload progress and tell you when a download link is ready. Without them you will only see updates inside the app.</string>
    <string name="allow_notifications">Allow notifications</string>
    <string name="not_now">Not now</string>

